# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Required. Used to sign NextAuth JWT sessions. `pnpm build` fails without
# this set. Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Required (types/env.d.ts declares it non-optional). NextAuth logs a
# [next-auth][warn][NEXTAUTH_URL] warning on every auth request without it.
NEXTAUTH_URL=http://localhost:3000
